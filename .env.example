# Copy to .env. Every variable is listed here with a safe local value.
APP_ENV=development
PORT=4100
# Comma-separated web origins allowed to call the API and open sockets.
# Use * to allow every origin while getting a deployment working.
CORS_ORIGINS=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=familytime
# Where the web app lives. Join links and QR codes are built from this, so on a
# home network set it to the host machine's address, e.g. http://192.168.1.20:5173
APP_URL=http://localhost:5173
LOG_LEVEL=info

# ---- Lagos Life (Vatar Games) ----
# Leave these empty for local development: outside production the server then
# accepts stand-in "dev:" sessions so the game runs without the platform.
# Keys come from https://lagoslife.app/developers/keys and are shown once.
VATAR_API_BASE=https://lagoslife.app/api/games/v1
# vtr_test_… while testing in their sandbox, vtr_live_… after approval.
VATAR_SECRET=
# Signs duel results. Server-side only; never ship it to the browser.
VATAR_RESULTS_SECRET=
